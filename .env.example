# The shared inbox the workflow reads and drafts replies in, for example support@ or hello@ on your domain.
GMAIL_ADDRESS=hello@your-business.example.com

# Google OAuth client and refresh token for that mailbox (docs/setup.md shows how to get them).
# Scopes: https://www.googleapis.com/auth/gmail.modify and https://www.googleapis.com/auth/spreadsheets.readonly
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token

# The FAQ sheet: column A is the question, column B the answer. Claude may only use these answers in a reply.
FAQ_SHEET_ID=your-spreadsheet-id
FAQ_RANGE=FAQ!A2:B

# Claude (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional, default claude-haiku-4-5 (the cheapest model that fits this high volume step). claude-sonnet-5 and
# claude-opus-5 also work. The request forces a tool call with thinking off, so claude-opus-5-5 and the Claude Fable
# and Mythos models do not work; the workflow refuses to start with them.
ANTHROPIC_MODEL=claude-haiku-4-5

# HubSpot private app access token. Scopes: crm.objects.contacts.read and crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token
# Optional: internal name of a contact property that gets the latest email category (create it in HubSpot first,
# for example a single-line text property "last_inbox_category"). Leave empty to record the category in a note only.
HUBSPOT_CATEGORY_PROPERTY=

# Slack incoming webhook for escalations, the daily digest and error alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# How the business is described to Claude
BUSINESS_NAME=Your Business Name
BUSINESS_ABOUT=a home cleaning service in Riverton
# Signature added under every draft. "\n" is a line break and {business_name} is replaced by BUSINESS_NAME.
DRAFT_SIGNATURE=Kind regards,\n{business_name}

# Which emails are looked at
# Gmail search the workflow starts from. newer_than:<LOOKBACK_DAYS>d is added to it.
GMAIL_QUERY=in:inbox -from:me
LOOKBACK_DAYS=2
# Most emails handled in one run (the rest wait for the next run)
MAX_PER_RUN=20
# Comma separated addresses or @domains that belong to the business. Their emails are skipped.
OWN_ADDRESSES=@your-business.example.com
# Parent name of the Gmail labels the workflow creates
LABEL_PREFIX=AI Triage

# When a person is alerted, and retries
# Below this confidence (0 to 1) a person is alerted even if Claude saw no other reason
CONFIDENCE_THRESHOLD=0.7
# Tries per email when Gmail or Claude fail before the draft, and the first wait in minutes (it doubles each time)
MAX_TRIAGE_TRIES=3
RETRY_BASE_MINUTES=5
# How long handled message ids are remembered. Must be larger than LOOKBACK_DAYS.
LEDGER_DAYS=30
# After this many minutes a run starts no more Claude calls; the remaining emails wait for the next run. Keep it at
# least 2 minutes below the inbox schedule (5 minutes by default), so two runs never work on the same emails at once.
RUN_TIME_LIMIT_MINUTES=3

# Self-hosted n8n must allow $env access in nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
